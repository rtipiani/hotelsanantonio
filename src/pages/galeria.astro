<script>
  document.addEventListener("astro:page-load", () => {
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement;
    const lightboxTitle = document.getElementById("lightbox-title");
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");
    const galleryImages = Array.from(
      document.querySelectorAll(".gallery-image"),
    ) as HTMLImageElement[];

    let currentIndex = 0;

    if (
      !lightbox ||
      !lightboxImg ||
      !closeBtn ||
      !prevBtn ||
      !nextBtn ||
      !lightboxTitle
    )
      return;

    const updateLightboxContent = (index: number) => {
      const img = galleryImages[index];
      if (img && img.src) {
        lightboxImg.classList.remove("scale-100");
        lightboxImg.classList.add("scale-95");
        lightboxImg.style.opacity = "0";
        lightboxTitle.style.opacity = "0";

        setTimeout(() => {
          lightboxImg.src = img.src;
          lightboxTitle.textContent = img.alt || "";

          lightboxImg.style.opacity = "1";
          lightboxImg.classList.remove("scale-95");
          lightboxImg.classList.add("scale-100");
          lightboxTitle.style.opacity = "1";
        }, 200);
      }
    };

    galleryImages.forEach((img, index) => {
      img.addEventListener("click", (e) => {
        currentIndex = index;
        const target = e.target as HTMLImageElement;
        if (target && target.src) {
          lightboxImg.src = target.src;
          lightboxTitle.textContent = target.alt || "";

          lightbox.classList.remove("hidden");
          lightbox.classList.add("flex");
          // Trigger reflow
          void lightbox.offsetWidth;

          lightbox.classList.remove("opacity-0");
          lightboxImg.style.opacity = "1";
          lightboxImg.classList.remove("scale-95");
          lightboxImg.classList.add("scale-100");
          lightboxTitle.classList.remove("opacity-0");
          lightboxTitle.style.opacity = "1";

          document.body.style.overflow = "hidden";
        }
      });
    });

    const showNext = (e?: Event) => {
      if (e) e.stopPropagation();
      currentIndex = (currentIndex + 1) % galleryImages.length;
      updateLightboxContent(currentIndex);
    };

    const showPrev = (e?: Event) => {
      if (e) e.stopPropagation();
      currentIndex =
        (currentIndex - 1 + galleryImages.length) % galleryImages.length;
      updateLightboxContent(currentIndex);
    };

    nextBtn.addEventListener("click", showNext);
    prevBtn.addEventListener("click", showPrev);

    const closeLightbox = () => {
      lightbox.classList.add("opacity-0");
      lightboxImg.classList.remove("scale-100");
      lightboxImg.classList.add("scale-95");
      lightboxTitle.style.opacity = "0";

      setTimeout(() => {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        lightboxImg.src = "";
        lightboxTitle.textContent = "";
        document.body.style.overflow = "";
      }, 300);
    };

    closeBtn.addEventListener("click", closeLightbox);

    lightbox.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (target === lightbox || target?.parentElement === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("hidden")) return;

      if (e.key === "Escape") {
        closeLightbox();
      } else if (e.key === "ArrowRight") {
        showNext();
      } else if (e.key === "ArrowLeft") {
        showPrev();
      }
    });
  });
</script>

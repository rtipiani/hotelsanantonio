---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
---

<Layout title="Sala de Reuniones">
  <Header client:load />
  <main class="min-h-screen bg-white py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-12 text-center">
      <span class="text-brand-primary font-bold uppercase tracking-widest text-sm mb-2 block">Eventos y Negocios</span>
      <h2 class="text-4xl md:text-5xl font-serif text-brand-text mb-6">Sala de Reuniones</h2>
      <p class="text-brand-text-muted max-w-3xl mx-auto text-lg leading-relaxed mb-16">
        Un espacio diseñado y equipado para que tus reuniones de negocios, talleres y presentaciones sean un completo éxito. Contamos con tecnología audiovisual de última generación, mobiliario corporativo, e internet de alta velocidad en un ambiente cómodo y privado.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-12">
        <div class="overflow-hidden h-64 md:h-80 relative group">
          <div class="absolute inset-0 bg-brand-text/10 group-hover:bg-transparent transition-colors z-10"></div>
          <img 
            src="/sala_reuniones/sala_reuniones1.avif" 
            alt="Sala de Reuniones" 
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>
        <div class="overflow-hidden h-64 md:h-80 relative group">
          <div class="absolute inset-0 bg-brand-text/10 group-hover:bg-transparent transition-colors z-10"></div>
          <img 
            src="/sala_reuniones/sala_reuniones2.avif" 
            alt="Mesa corporativa" 
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>
        <div class="overflow-hidden h-64 md:h-80 relative group">
          <div class="absolute inset-0 bg-brand-text/10 group-hover:bg-transparent transition-colors z-10"></div>
          <img 
            src="/sala_reuniones/sala_reuniones3.avif" 
            alt="Instalaciones de la sala" 
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>
        <div class="overflow-hidden h-64 md:h-80 relative group">
          <div class="absolute inset-0 bg-brand-text/10 group-hover:bg-transparent transition-colors z-10"></div>
          <img 
            src="/sala_reuniones/sala_reuniones4.avif" 
            alt="Equipamiento" 
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
---

<Layout title="Sala de Reuniones">
  <Header client:load />
  <main class="min-h-screen bg-white py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-12 text-center">
      <span className="text-brand-primary font-bold uppercase tracking-widest text-sm mb-2 block">Eventos y Negocios</span>
      <h2 className="text-4xl md:text-5xl font-serif text-brand-text mb-6">Sala de Reuniones</h2>
      <p className="text-brand-text-muted max-w-3xl mx-auto text-lg leading-relaxed">
        Próximamente: Un espacio diseñado y equipado para que tus reuniones de negocios, talleres y presentaciones sean un completo éxito.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

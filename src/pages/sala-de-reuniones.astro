---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
---

<Layout title="Sala de Reuniones">
  <Header client:load />
  <main class="min-h-screen bg-white py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-12 text-center">
      <span class="text-brand-primary font-bold uppercase tracking-widest text-sm mb-2 block">Eventos y Negocios</span>
      <h2 class="text-4xl md:text-5xl font-serif text-brand-text mb-6">Sala de Reuniones</h2>
      <div class="text-left max-w-5xl mx-auto mb-16 mt-8">
        <p class="text-brand-text-muted text-sm leading-relaxed mb-12 text-center max-w-3xl mx-auto font-light">
          Disponemos de una moderna sala de reuniones con capacidad para hasta <span class="font-normal text-brand-primary">35 personas</span>, diseñada para garantizar el éxito de sus eventos.
        </p>
        
        <div class="mb-12">
          <h3 class="text-base font-bold text-brand-text mb-6 text-center uppercase tracking-wide">Ideal para</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 px-4 md:px-0">
            {[
              "Reuniones corporativas", 
              "Capacitaciones", 
              "Talleres", 
              "Entrevistas laborales", 
              "Presentaciones comerciales", 
              "Reuniones de directorio", 
              "Cursos y seminarios", 
              "Coworking", 
              "Actividades institucionales"
            ].map(item => (
              <div class="flex items-center gap-3 bg-white p-4 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <svg class="w-5 h-5 text-brand-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-brand-text-muted text-sm font-light">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="relative bg-brand-text text-white p-6 rounded-xl mb-12 overflow-hidden shadow-lg mx-4 md:mx-0">
          <div class="relative z-10 text-center max-w-3xl mx-auto">
            <svg class="w-6 h-6 mx-auto mb-4 text-brand-primary opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
            </svg>
            <p class="text-sm leading-relaxed text-white/90 font-light">
              La sala ofrece una hermosa vista a la <span class="text-brand-primary font-medium">Plaza e Iglesia San Antonio</span> y acceso directo a una amplia terraza, proporcionando un ambiente cómodo, iluminado y verdaderamente profesional.
            </p>
          </div>
          <div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-brand-primary opacity-20 rounded-full blur-3xl"></div>
          <div class="absolute bottom-0 left-0 -mb-10 -ml-10 w-40 h-40 bg-brand-primary opacity-20 rounded-full blur-3xl"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16 px-4 md:px-0">
          <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-8 hover:shadow-lg transition-shadow">
            <div class="flex items-center gap-4 mb-8">
              <div class="bg-brand-primary/10 p-2.5 rounded-lg">
                <svg class="w-5 h-5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-brand-text uppercase tracking-wide">Configuraciones</h3>
            </div>
            <ul class="space-y-3">
              {["Montaje tipo Escuela", "Montaje tipo Gerencial"].map(item => (
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-brand-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-brand-text-muted text-sm font-light">{item}</span>
                </li>
              ))}
            </ul>
          </div>
          
          <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-8 hover:shadow-lg transition-shadow">
            <div class="flex items-center gap-4 mb-8">
              <div class="bg-brand-primary/10 p-2.5 rounded-lg">
                <svg class="w-5 h-5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-brand-text uppercase tracking-wide">Equipamiento</h3>
            </div>
            <ul class="space-y-3">
              {[
                "Smart TV de 80 pulgadas",
                "Conexión HDMI",
                "Internet WiFi de alta velocidad",
                "Agua mineral",
                "Servicio de impresión, fotocopias y escaneos",
                "Atención personalizada",
                "Mobiliario adaptable",
                "Alquiler por horas o jornada completa"
              ].map(item => (
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-brand-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-brand-text-muted text-sm font-light">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="bg-gradient-to-r from-gray-50 to-white p-8 md:p-10 rounded-2xl border border-gray-200 flex flex-col md:flex-row gap-6 items-start mx-4 md:mx-0 shadow-sm relative overflow-hidden">
          <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-brand-primary"></div>
          <div class="bg-white p-3 rounded-full shadow-sm shrink-0 text-brand-primary">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-brand-text-muted mb-2 text-sm leading-relaxed font-light">
              Los huéspedes alojados podrán solicitar el uso de la sala para reuniones individuales o actividades internas, sujeto a disponibilidad y coordinación previa.
            </p>
            <p class="text-brand-text font-normal text-sm leading-relaxed">
              Cuando la reunión incluya invitados externos o requiera montaje especial, se ofrecerán <span class="text-brand-primary font-bold">tarifas preferenciales</span> para huéspedes.
            </p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-12">
        <div class="overflow-hidden h-64 md:h-80 relative group">
          <div class="absolute inset-0 bg-brand-text/10 group-hover:bg-transparent transition-colors z-10"></div>
          <img 
            src="/sala_reuniones/sala_reuniones1.avif" 
            alt="Sala de Reuniones" 
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>
        <div class="overflow-hidden h-64 md:h-80 relative group">
          <div class="absolute inset-0 bg-brand-text/10 group-hover:bg-transparent transition-colors z-10"></div>
          <img 
            src="/sala_reuniones/sala_reuniones2.avif" 
            alt="Mesa corporativa" 
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>
        <div class="overflow-hidden h-64 md:h-80 relative group">
          <div class="absolute inset-0 bg-brand-text/10 group-hover:bg-transparent transition-colors z-10"></div>
          <img 
            src="/sala_reuniones/sala_reuniones3.avif" 
            alt="Instalaciones de la sala" 
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>
        <div class="overflow-hidden h-64 md:h-80 relative group">
          <div class="absolute inset-0 bg-brand-text/10 group-hover:bg-transparent transition-colors z-10"></div>
          <img 
            src="/sala_reuniones/sala_reuniones4.avif" 
            alt="Equipamiento" 
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection';
---

<Layout title="Contacto">
  <Header client:load />
  
  {/* Hero Banner */}
  <div class="relative h-64 md:h-96 mt-20 md:mt-24">
    <div class="absolute inset-0 bg-brand-text/60 z-10"></div>
    <img 
      src="https://images.unsplash.com/photo-1563911302283-d2bc129e7570?auto=format&fit=crop&q=80" 
      alt="Contacto Hotel Plaza San Antonio" 
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 z-20 flex flex-col items-center justify-center text-center px-6">
      <span class="text-brand-primary font-bold uppercase tracking-widest text-sm mb-4 block">Asistencia Personalizada</span>
      <h1 class="text-4xl md:text-6xl font-serif text-white mb-6">Contacto</h1>
      <p class="text-white/90 max-w-2xl mx-auto text-lg">
        Nuestro compromiso es ofrecerle una excelente experiencia antes, durante y después de su estadía.
      </p>
    </div>
  </div>

  <main class="bg-brand-bg/30 py-20 md:py-32">
    <ContactSection client:load />
  </main>
  
  <Footer />
</Layout>

---
export const prerender = false;

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD || 'admin123';
let error = false;

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const password = data.get('password');
  
  if (typeof password === 'string' && password === ADMIN_PASSWORD) {
    Astro.cookies.set('admin_token', password, { path: '/', httpOnly: true, maxAge: 60 * 60 * 24 * 7 });
    return Astro.redirect('/admin');
  } else {
    error = true;
  }
}
---

<html lang="es">
<head>
  <title>Login - Admin Hotel San Antonio</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen">
  <div class="bg-white p-8 rounded-lg shadow-xl shadow-black/5 border border-gray-100 w-full max-w-sm">
    <div class="text-center mb-8">
      <img src="/logo.webp" alt="Logo" class="h-16 mx-auto mb-4" onerror="this.style.display='none'" />
      <h1 class="text-2xl font-serif text-brand-primary-dark">Acceso Privado</h1>
    </div>

    {error && <p class="text-red-500 text-sm mb-4 text-center font-bold">Contraseña incorrecta</p>}
    
    <form method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-bold tracking-widest uppercase text-gray-500 mb-2">Contraseña maestra</label>
        <input 
          type="password" 
          name="password" 
          required 
          placeholder="••••••••"
          class="w-full border border-gray-300 rounded-md px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent transition-all" 
        />
      </div>
      <button 
        type="submit" 
        class="w-full bg-brand-primary text-white font-bold py-3 rounded-md hover:bg-brand-primary-dark transition-colors uppercase tracking-widest text-sm mt-4"
      >
        Entrar al Panel
      </button>
    </form>
    
    <div class="mt-6 text-center">
      <a href="/" class="text-sm text-gray-400 hover:text-brand-primary transition-colors">← Volver a la web</a>
    </div>
  </div>
</body>
</html>


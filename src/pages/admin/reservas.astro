---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { CalendarDays, Filter, Plus } from 'lucide-react';

const cookieValue = Astro.cookies.get('admin_token')?.value;
const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD || 'admin123';
if (cookieValue !== ADMIN_PASSWORD) return Astro.redirect('/admin/login');
---
<AdminLayout title="Reservas">
  <div class="flex justify-between items-center mb-8">
    <div>
      <h2 class="text-2xl font-bold font-sans text-gray-900 dark:text-white mb-1">Gestión de Reservas</h2>
      <p class="text-gray-500 dark:text-zinc-400 text-sm">Administra las reservas entrantes y confirmadas de tu hotel.</p>
    </div>
    <div class="flex gap-3">
      <button class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-zinc-700 transition-colors">
        <Filter size={16} /> Filtros
      </button>
      <button class="flex items-center gap-2 px-4 py-2 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark transition-colors shadow-sm">
        <Plus size={16} /> Nueva Reserva
      </button>
    </div>
  </div>

  <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-gray-100 dark:border-zinc-800 shadow-sm p-12 text-center">
    <div class="w-16 h-16 bg-brand-primary/10 text-brand-primary rounded-full flex items-center justify-center mx-auto mb-4">
      <CalendarDays size={32} />
    </div>
    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">No hay reservas automatizadas</h3>
    <p class="text-gray-500 dark:text-zinc-400 max-w-md mx-auto mb-6">
      Actualmente el sitio canaliza a los clientes hacia WhatsApp. Esta pantalla está lista para integrarse con un Motor de Reservas o PMS en el futuro.
    </p>
  </div>
</AdminLayout>


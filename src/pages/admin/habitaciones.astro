---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { BedDouble, Plus } from 'lucide-react';

const cookieValue = Astro.cookies.get('admin_token')?.value;
if (cookieValue !== (import.meta.env.ADMIN_PASSWORD || 'admin123')) return Astro.redirect('/admin/login');
---
<AdminLayout title="Habitaciones">
  <div class="flex justify-between items-center mb-8">
    <div>
      <h2 class="text-2xl font-bold font-sans text-gray-900 dark:text-white mb-1">Inventario de Habitaciones</h2>
      <p class="text-gray-500 dark:text-zinc-400 text-sm">Controla la disponibilidad, precios y características de tus habitaciones.</p>
    </div>
    <button class="flex items-center gap-2 px-4 py-2 bg-brand-primary text-white rounded-lg text-sm font-medium hover:bg-brand-primary-dark transition-colors shadow-sm">
      <Plus size={16} /> Añadir Habitación
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Demo Card -->
    <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-gray-100 dark:border-zinc-800 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
      <div class="h-40 bg-gray-200 dark:bg-zinc-800 flex items-center justify-center">
        <span class="text-gray-400 text-xs uppercase tracking-widest font-bold">Imagen Habitación</span>
      </div>
      <div class="p-5">
        <div class="flex justify-between items-start mb-2">
          <h3 class="font-bold text-lg dark:text-white">Habitación Matrimonial Clásica</h3>
          <span class="px-2 py-1 bg-green-100 text-green-700 dark:bg-green-500/10 dark:text-green-400 rounded text-xs font-bold">Disponible</span>
        </div>
        <p class="text-sm text-gray-500 mb-4">Cama Matrimonial • Vista Interior</p>
        <div class="flex justify-between items-center pt-4 border-t border-gray-100 dark:border-zinc-800">
          <span class="font-bold text-brand-primary">S/ 90.00</span>
          <button class="text-xs text-gray-500 hover:text-brand-primary font-medium">Editar</button>
        </div>
      </div>
    </div>
    <!-- Dummy empty state -->
    <div class="bg-gray-50 dark:bg-zinc-900/50 rounded-2xl border border-dashed border-gray-300 dark:border-zinc-700 flex flex-col items-center justify-center p-8 text-center h-full min-h-[300px]">
      <BedDouble size={32} className="text-gray-400 mb-3" />
      <p class="text-sm text-gray-500 dark:text-zinc-400">Esta interfaz está preparada para cargar el catálogo dinámicamente desde una base de datos cuando integres un backend completo.</p>
    </div>
  </div>
</AdminLayout>


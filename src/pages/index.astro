---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import HeroSlider from '../components/HeroSlider';
import Welcome from '../components/Welcome';
import Features from '../components/Features';
import Location from '../components/Location';
import WhatToSee from '../components/WhatToSee';
import WebBenefits from '../components/WebBenefits';
import RoomsPreview from '../components/RoomsPreview';
import Footer from '../components/Footer.astro';
---

<Layout title="Inicio">
  <Header client:load />
  <main>
    <HeroSlider client:load />
    <WebBenefits client:visible />
    <Welcome />
    <Features client:visible />
    <Location />
    <WhatToSee client:visible />
    <RoomsPreview client:visible />
  </main>
  <Footer />
</Layout>

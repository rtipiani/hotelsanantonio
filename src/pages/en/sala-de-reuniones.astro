---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer.astro';
---

<Layout title="Meeting Room">
  <Header lang="en" client:load />
  <main class="min-h-screen bg-white py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-12 text-center">
      <span className="text-brand-primary font-bold uppercase tracking-widest text-sm mb-2 block">Events and Business</span>
      <h2 className="text-4xl md:text-5xl font-serif text-brand-text mb-6">Meeting Room</h2>
      <p className="text-brand-text-muted max-w-3xl mx-auto text-lg leading-relaxed">
        Coming soon: A space designed and equipped to make your business meetings, workshops, and presentations a complete success.
      </p>
    </div>
  </main>
  <Footer lang="en" />
</Layout>

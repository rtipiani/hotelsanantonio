---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer.astro';
---

<Layout title="Gallery">
  <Header lang="en" client:load />
  <main class="min-h-screen pt-32 pb-24 bg-brand-bg">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-serif text-brand-text mb-4">Gallery</h1>
        <p class="text-brand-text-muted max-w-2xl mx-auto text-lg">A glimpse into your next urban haven.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <img src="https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&q=80" alt="Hotel" class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500" />
        <img src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&q=80" alt="Matrimonial Room" class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500" />
        <img src="https://images.unsplash.com/photo-1578683010236-d716f9a3f461?auto=format&fit=crop&q=80" alt="Double Room" class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500" />
        <img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&q=80" alt="Corporate Suite" class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500" />
        <img src="https://images.unsplash.com/photo-1414235077428-338988a2e8c0?auto=format&fit=crop&q=80" alt="Restaurant" class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500" />
        <img src="https://images.unsplash.com/photo-1582719508461-905c673771fd?auto=format&fit=crop&q=80" alt="Details" class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500" />
      </div>
    </div>
  </main>
  <Footer lang="en" />
</Layout>

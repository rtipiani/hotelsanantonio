---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer.astro';
import ContactSection from '../../components/ContactSection';
---

<Layout title="Contact">
  <Header lang="en" client:load />
  
  {/* Hero Banner */}
  <div class="relative h-48 md:h-64">
    <div class="absolute inset-0 bg-brand-text/60 z-10"></div>
    <img 
      src="/arequipa_plaza.avif" 
      alt="Discover Arequipa" 
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 z-20 flex flex-col items-center justify-center text-center px-6">
      <h1 class="text-3xl md:text-4xl font-serif text-white mb-4">DISCOVER AREQUIPA</h1>
      <p class="text-white/90 max-w-2xl mx-auto text-sm md:text-base">
        Fill your trip with adventures and unforgettable experiences.
      </p>
    </div>
  </div>

  <main class="bg-brand-bg/30 py-20 md:py-32">
    <ContactSection lang="en" client:load />
  </main>
  
  <Footer lang="en" />
</Layout>


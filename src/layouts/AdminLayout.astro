---
import '../styles/global.css'; // Asegurando estilos globales si existen, Tailwind ya está inyectado globalmente en Astro v4/v5 si se usa @tailwindcss/vite.
import { Sidebar } from '../components/admin/Sidebar.tsx';

interface Props {
	title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es" class="bg-gray-50 dark:bg-zinc-950 text-gray-900 dark:text-zinc-100 antialiased">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Admin San Antonio</title>
    <style>
      :global(.admin-body), :global(.admin-body *) {
        font-family: var(--font-sans) !important;
      }
    </style>
    <!-- Rastreador de Analíticas Nativo -->
    <script is:inline>
      document.addEventListener('click', (e) => {
        // Encontrar si se hizo clic en un botón o en un enlace (o dentro de ellos)
        const target = e.target.closest('button, a');
        if (!target) return;
        
        // Obtener el texto o un identificador
        const label = target.innerText?.trim() || target.getAttribute('aria-label') || target.getAttribute('title') || 'Elemento sin texto';
        const tag = target.tagName.toLowerCase();
        const path = window.location.pathname;
        const href = target.getAttribute('href') || '';

        // Ignorar clics demasiado largos o ruidosos
        if (label.length > 50) return;

        // Enviar silenciosamente a nuestra API nativa
        fetch('/api/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ label, tag, path, href, timestamp: new Date().toISOString() })
        }).catch(err => {
          // Fallo silencioso si la API no está lista
        });
      });
    </script>
	</head>
	<body class="flex h-screen overflow-hidden admin-body">
		<!-- Menú Lateral -->
		<Sidebar client:load currentPath={currentPath} />

		<!-- Contenido Principal -->
		<main class="flex-1 flex flex-col h-screen overflow-y-auto bg-gray-50 dark:bg-zinc-950/50 relative">
      <!-- Navbar superior del Admin -->
      <header class="sticky top-0 z-10 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-md border-b border-gray-200 dark:border-zinc-800 px-8 py-4 flex justify-between items-center">
        <h1 class="text-xl font-bold font-sans text-brand-text dark:text-brand-primary">{title}</h1>
        <div class="flex items-center gap-4">
          <button class="p-2 text-gray-500 hover:text-brand-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          </button>
          <div class="h-10 w-10 rounded-full bg-brand-primary text-white flex items-center justify-center font-bold shadow-md cursor-pointer hover:bg-brand-primary/90 transition-colors">
            A
          </div>
        </div>
      </header>

      <!-- Contenedor del contenido -->
			<div class="p-8 mx-auto w-full max-w-7xl">
        <slot />
      </div>
		</main>
	</body>
</html>

